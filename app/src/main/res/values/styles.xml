<resources>
    <style name="Walok" />
    <style name="Walok.Title">
        <item name="android:textSize">@dimen/walok_font_title</item>
        <item name="android:textColor">@color/walok_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Walok.Body">
        <item name="android:textSize">@dimen/walok_font_body</item>
        <item name="android:textColor">@color/walok_ink</item>
    </style>
    <style name="Walok.Description">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/walok_muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Walok.Label">
        <item name="android:textSize">@dimen/walok_font_label</item>
        <item name="android:textColor">@color/walok_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Walok.Muted">
        <item name="android:textSize">@dimen/walok_font_label</item>
        <item name="android:textColor">@color/walok_muted</item>
    </style>
    <style name="Walok.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/walok_input</item>
        <item name="backgroundTint">@null</item>
        <item name="android:minHeight">@dimen/walok_control_height</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/walok_ink</item>
        <item name="android:textColorHint">@color/walok_muted</item>
        <item name="android:textSize">@dimen/walok_font_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="Walok.Readonly" parent="Walok.Body">
        <item name="android:background">@drawable/walok_readonly</item>
        <item name="android:minHeight">@dimen/walok_control_height</item>
        <item name="android:padding">14dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="Walok.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/walok_control_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/walok_font_body</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/walok_background</item>
        <item name="backgroundTint">@color/walok_button_background</item>
        <item name="cornerRadius">@dimen/walok_radius</item>
        <item name="iconTint">@color/walok_background</item>
        <item name="iconGravity">textStart</item>
    </style>
    <style name="Walok.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/walok_control_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">@dimen/walok_font_label</item>
        <item name="android:textColor">@color/walok_ink</item>
        <item name="strokeColor">@color/walok_line</item>
        <item name="cornerRadius">@dimen/walok_radius</item>
    </style>
    <style name="Walok.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/walok_hit_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">@dimen/walok_font_label</item>
        <item name="android:textColor">@color/walok_muted</item>
        <item name="iconTint">@color/walok_muted</item>
        <item name="iconGravity">textStart</item>
    </style>
</resources>
