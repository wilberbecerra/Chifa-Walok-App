<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/walok_background" />
            <corners android:radius="@dimen/walok_radius" />
            <stroke android:width="2dp" android:color="@color/walok_primary" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/walok_background" />
            <corners android:radius="@dimen/walok_radius" />
            <stroke android:width="1dp" android:color="@color/walok_line" />
        </shape>
    </item>
</selector>
