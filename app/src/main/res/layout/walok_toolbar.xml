<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/walok_header">
    <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
        <ImageView android:id="@+id/toolbarLogo" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/logo" android:scaleType="fitCenter" android:contentDescription="@string/logo_description" android:padding="0dp" android:background="@drawable/walok_logo_plate" android:layout_marginEnd="12dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/brand_name" android:textColor="@color/walok_on_header" android:textSize="23sp" android:fontFamily="sans-serif-medium" android:layout_marginEnd="14dp" />
        <View android:layout_width="1dp" android:layout_height="20dp" android:background="@color/walok_header_muted" android:alpha="0.3" />
        <TextView style="@style/Walok.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="@string/brand_context" android:textSize="13sp" android:textColor="@color/walok_header_muted" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/walok_header_muted" android:alpha="0.3" android:visibility="gone" />
</LinearLayout>
